# ============================================
  # Ghostty Terminal - Complete Configuration
  # ============================================
  # File: ~/.config/ghostty/config
  # Reload: Cmd+Shift+, (macOS) / Ctrl+Shift+, (Linux)
  # Shared by every machine. OS-specific keybindings and window settings live
  # in macos.conf / linux.conf, linked as ~/.config/ghostty/platform.conf and
  # included at the bottom of this file.
  # View options: ghostty +show-config --default --docs

  # --- Typography ---
  font-family = "JetBrainsMono Nerd Font Mono"
  font-size = 14
  # Removes the dark fringes around colored text on dark backgrounds.
  alpha-blending = linear-corrected
  adjust-cell-height = 2

  # --- Theme and Colors ---
  # Catppuccin with automatic light/dark switching
  theme = Catppuccin Mocha

  # --- Window and Appearance ---
  background-opacity = 1.0
  window-padding-x = 10
  window-padding-y = 8
  window-save-state = always
  window-theme = auto

  # --- Cursor ---
  cursor-style = bar
  cursor-style-blink = true
  cursor-opacity = 0.8

  # --- Mouse ---
  mouse-hide-while-typing = true
  copy-on-select = clipboard

  # --- Quick Terminal (Quake-style dropdown) ---
  # Toggled by the global hotkey in platform.conf
  quick-terminal-position = top
  quick-terminal-screen = mouse
  quick-terminal-autohide = true
  quick-terminal-animation-duration = 0.15

  # --- Security ---
  # Never answer OSC 52 clipboard *reads*. A program can ask the terminal for
  # the clipboard with ESC]52;c;? and the terminal replies on the program's
  # own stdin as ESC]52;c;<base64>. A program that does not consume that reply
  # shows the base64 as if it had been typed: Claude Code does this, so after
  # a mouse selection (copy-on-select above puts it on the clipboard) a click
  # filled its prompt with a screenful of base64. Writes stay allowed, which
  # is what copying out of a terminal program needs; only reads are refused.
  # The cost is that a program that legitimately reads the clipboard this way
  # (Neovim over SSH) no longer can.
  clipboard-read = deny
  clipboard-paste-protection = true
  clipboard-paste-bracketed-safe = true

  # --- Shell Integration ---
  shell-integration = detect

  # --- Performance ---
  # Generous scrollback (25MB)
  scrollback-limit = 25000000

  # --- Per-OS settings (keybindings, window chrome) ---
  # `?` = optional: Ghostty still starts if the file is missing.
  config-file = ?platform.conf
