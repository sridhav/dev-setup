# Catppuccin Latte palette for Powerlevel10k — the light flavour.
#
# Sourced by zsh/p10k.zsh before the prompt style (p10k-classic.zsh or
# p10k-rainbow.zsh), which refer to these names and never to a hex value, so
# one palette swap recolours either style. `typeset -g` keeps them global for
# the style file's anonymous function.
#
# Which one is used follows $DEV_SETUP_FLAVOUR (zsh/theme.zsh): make light /
# make dark. Keep the two palettes in step — same names, same order.

typeset -g P10K_COLOR_BASE="#eff1f5"   # Base
typeset -g P10K_COLOR_MANTLE="#e6e9ef" # Mantle
typeset -g P10K_COLOR_CRUST="#dce0e8"  # Crust

# Text and Subtext
typeset -g P10K_COLOR_TEXT="#4c4f69"     # Text
typeset -g P10K_COLOR_SUBTEXT1="#5c5f77" # Subtext 1
typeset -g P10K_COLOR_SUBTEXT0="#6c6f85" # Subtext 0

# Overlays
typeset -g P10K_COLOR_OVERLAY2="#7c7f93" # Overlay 2
typeset -g P10K_COLOR_OVERLAY1="#8c8fa1" # Overlay 1
typeset -g P10K_COLOR_OVERLAY0="#9ca0b0" # Overlay 0

# Surfaces
typeset -g P10K_COLOR_SURFACE2="#acb0be" # Surface 2
typeset -g P10K_COLOR_SURFACE1="#bcc0cc" # Surface 1
typeset -g P10K_COLOR_SURFACE0="#ccd0da" # Surface 0

# Accent colors
typeset -g P10K_COLOR_BLUE="#1e66f5"      # Blue
typeset -g P10K_COLOR_LAVENDER="#7287fd"  # Lavender
typeset -g P10K_COLOR_SAPPHIRE="#209fb5"  # Sapphire
typeset -g P10K_COLOR_SKY="#04a5e5"       # Sky
typeset -g P10K_COLOR_TEAL="#179299"      # Teal
typeset -g P10K_COLOR_GREEN="#40a02b"     # Green
typeset -g P10K_COLOR_YELLOW="#df8e1d"    # Yellow
typeset -g P10K_COLOR_PEACH="#fe640b"     # Peach
typeset -g P10K_COLOR_RED="#d20f39"       # Red
typeset -g P10K_COLOR_MAROON="#e64553"    # Maroon
typeset -g P10K_COLOR_PINK="#ea76cb"      # Pink
typeset -g P10K_COLOR_FLAMINGO="#dd7878"  # Flamingo
typeset -g P10K_COLOR_ROSEWATER="#dc8a78" # Rosewater
typeset -g P10K_COLOR_MAUVE="#8839ef"     # Mauve
